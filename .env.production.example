# Production .env for the VPS — copy to `.env` and fill real values.
#   cp .env.production.example .env   (then edit; never commit the filled .env)
# Validated at build AND startup (src/lib/server/env.ts). Run: npm run validate-env
#
# HARD production gates (build + boot fail without these):
#   - NODE_ENV=production
#   - STRAPI_API_URL must be a valid HTTPS URL
#   - DATABASE_URL must be a valid mysql:// URL
#   - BETTER_AUTH_SECRET >= 32 chars
#   - any secret that IS set must be >= 32 chars

NODE_ENV=production

# --- App origin / auth -------------------------------------------------------
ORIGIN=https://taxnexusapp.com
BETTER_AUTH_URL=https://taxnexusapp.com
BETTER_AUTH_TRUSTED_ORIGINS=https://taxnexusapp.com,https://www.taxnexusapp.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_32+_char_random_secret_value
DATABASE_AUTH_PATH=/app/data/auth.sqlite

# --- Strapi (served at https://cms.taxnexusapp.com via nginx) -----------------
STRAPI_API_URL=https://cms.taxnexusapp.com
PUBLIC_STRAPI_URL=https://cms.taxnexusapp.com
STRAPI_API_TOKEN=replace_with_strapi_api_token_32+_chars
STRAPI_WEBHOOK_SECRET=replace_with_webhook_shared_secret_32+_chars

# --- Prisma / MySQL (db service on the compose network) ----------------------
DATABASE_URL=mysql://mautic_db_user:superSecretUserPwd@db:3306/soloai_db

# --- Docker / MySQL / Strapi container config --------------------------------
COMPOSE_PROJECT_NAME=taxnexus-prod
COMPOSE_NETWORK=${COMPOSE_PROJECT_NAME}-docker
BASE_PATH=/opt/taxnexus
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=mautic_db
MYSQL_USER=mautic_db_user
MYSQL_STRAPI_USER=strapi_db_user
MYSQL_PASSWORD=replace_with_strong_password_32+_chars
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password_32+_chars
JWT_SECRET=replace_with_strong_secret_32+_chars
ADMIN_JWT_SECRET=replace_with_strong_secret_32+_chars
APP_KEYS=replace_with_strong_secret_32+_chars
API_TOKEN_SALT=replace_with_strong_secret_32+_chars
TRANSFER_TOKEN_SALT=replace_with_strong_secret_32+_chars
DOCKER_MAUTIC_LOAD_TEST_DATA=false
DOCKER_MAUTIC_RUN_MIGRATIONS=true

# --- OpenAI translation (optional) -------------------------------------------
OPENAI_API_KEY=replace_or_remove
OPENAI_MODEL=gpt-5-mini
TRANSLATION_ENABLED=false
TRANSLATION_API_TOKEN=replace_with_token_32+_chars

# --- Billing (optional; if ANY var of a provider is set, ALL are required) ----
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=https://taxnexusapp.com/account
# STRIPE_CANCEL_URL=https://taxnexusapp.com/pricing
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# LEMON_SQUEEZY_ENVIRONMENT=production
# LEMON_SQUEEZY_CHECKOUT_SUCCESS_URL=https://taxnexusapp.com/account
# LEMON_SQUEEZY_CHECKOUT_CANCEL_URL=https://taxnexusapp.com/pricing

# --- In-app display prices (optional; base monthly USD shown before checkout) ---
# Display only — the real charge comes from the Stripe price / Lemon variant, and
# non-US buyers are billed in local currency by Lemon Squeezy (MoR). Defaults are
# built in (Guard $39, Aggregator $119); set these only to override the display.
# PRICE_BASIC_USD=39     # "Guard" tier
# PRICE_PRO_USD=119      # "Aggregator" tier

{
  "manifest_version": 3,
  "name": "TaxNexus — CA Nexus Alert for FBA Sellers",
  "short_name": "TaxNexus Alert",
  "version": "1.0.0",
  "description": "Flags California nexus exposure for Amazon FBA sellers by detecting CA fulfillment-center inventory signals on Amazon Seller Central.",
  "homepage_url": "https://taxnexusapp.com",
  "action": {
    "default_title": "TaxNexus Nexus Alert",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png",
      "48": "icons/toolbar48.png",
      "128": "icons/toolbar128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://sellercentral.amazon.com/*"],
      "js": ["content/amazon-collector.js"],
      "run_at": "document_idle"
    }
  ]
}

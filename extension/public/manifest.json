{
  "manifest_version": 3,
  "name": "TaxNexus Nexus Alert Toolbar",
  "version": "0.1.0",
  "description": "Flags California nexus exposure for Amazon FBA sellers by detecting CA fulfillment-center inventory signals on Amazon Seller Central.",
  "action": {
    "default_title": "TaxNexus Nexus Alert",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "content_scripts": [
    {
      "matches": [
        "https://sellercentral.amazon.com/*",
        "https://www.amazon.com/*"
      ],
      "js": ["content/amazon-collector.js"],
      "run_at": "document_idle"
    }
  ]
}

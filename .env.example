# Validated at process startup (see src/lib/server/env.ts). Run: npm run validate-env
# NODE_ENV: development | production | test
# Rotation (optional): pair PRIMARY with PRIMARY_NEXT (e.g. STRAPI_API_TOKEN_NEXT) for dual-run cutover — never mix env-specific files.

# Strapi Configuration (server REST + public asset base; legacy STRAPI_BASE_URL still accepted)
STRAPI_API_URL=http://localhost:1337
PUBLIC_STRAPI_URL=http://localhost:1337

# API Token for Content Localization (created in Strapi Admin)
# Go to: Settings → API Tokens → Create new API Token
STRAPI_API_TOKEN=your_api_token_here

# Strapi → app webhook (Settings → Webhooks → translate-content). Use Bearer token in Authorization header.
STRAPI_WEBHOOK_SECRET=your_webhook_shared_secret_here

# Google Tag Manager / analytics (optional; TC01–TC03). Set PUBLIC_GTM_CONTAINER_ID to enable GTM + dataLayer in the app shell.
# PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
# Server-only pepper for SHA-256 user id in dataLayer (recommended in production).
# ANALYTICS_USER_HASH_PEPPER=
# Optional strict HTML CSP for GTM / GA4 / Hotjar (may require tuning for your stack).
# ENABLE_HTML_CSP=true
# Optional route transitions (fade/slide ~260ms); respects prefers-reduced-motion and localStorage pageTransitionsOff=1
# PUBLIC_PAGE_TRANSITIONS_ENABLED=true

# Anthropic Configuration (chat assistant)
# Optional but needed for the chatbot: when unset, /api/chat returns 503 and the
# rest of the site runs normally (a missing key never blocks boot). Format-checked
# when set (must start with "sk-ant-"). Server-only; never exposed to the client.
# Powers the /api/chat California nexus compliance assistant (Claude Sonnet 4.6).
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenAI Configuration (optional — AI translation workflow only)
# Server-only; never logged.
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-5-mini
TRANSLATION_ENABLED=true

# Translation API Authentication
TRANSLATION_API_TOKEN=your_secure_api_token_here

# Docker Compose Configuration (already configured)
COMPOSE_PROJECT_NAME=soloai-dev
COMPOSE_NETWORK=${COMPOSE_PROJECT_NAME}-docker
MYSQL_HOST=db.${COMPOSE_NETWORK}
BASE_PATH=your_desired_base_path_here
MYSQL_PORT=3306
MYSQL_DATABASE=mautic_db
MYSQL_USER=mautic_db_user
MYSQL_STRAPI_USER=strapi_db_user
MYSQL_PASSWORD=superSecretUserPwd
MYSQL_ROOT_PASSWORD=superSecretRootPwd
JWT_SECRET="KzLWX7hH9uFh8tK6XqY5Yg=="
ADMIN_JWT_SECRET="uMJTkAzD9PKl5Tn2SFD5Zg=="
APP_KEYS="WuOGFC7kKeZmAxn3YwZytg=="
API_TOKEN_SALT="Eo7ZrJjNd6C8EZZi7FiPYw=="
TRANSFER_TOKEN_SALT="rBmJQbKeBPG1vKXyc05TWw=="

# Mautic REST (optional; official UI/API/CLI for credentials). Use one auth method only.
# MAUTIC_API_URL=http://localhost:8080
# MAUTIC_API_TOKEN=
# MAUTIC_CLIENT_ID=
# MAUTIC_CLIENT_SECRET=
# MAUTIC_USERNAME=
# MAUTIC_PASSWORD=
# MAUTIC_DEFAULT_SEGMENT_ID=
# MAUTIC_RATE_LIMIT=100

# Better Auth (SQLite; run: npx @better-auth/cli migrate --yes --config ./src/lib/auth.ts)
# BETTER_AUTH_SECRET: required in production (≥32 chars). Optional dev placeholder when NODE_ENV is not production.
# BETTER_AUTH_URL: app origin (e.g. http://localhost:5173)
# DATABASE_AUTH_PATH: optional path to SQLite file (default ./data/auth.sqlite)
# PUBLIC_STRIPE_PORTAL_URL / PUBLIC_LEMON_PORTAL_URL: optional billing portal links for the account dashboard
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:5173
# DATABASE_AUTH_PATH=./data/auth.sqlite
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PUBLIC_STRIPE_PORTAL_URL=
# PUBLIC_LEMON_PORTAL_URL=
#
# Stripe (optional; when any key is set, all five are required — see src/lib/server/env.ts)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=http://localhost:5173/account
# STRIPE_CANCEL_URL=http://localhost:5173/pricing
# Webhook URL (Dashboard → Developers → Webhooks): https://<your-host>/api/stripe/webhook
# Billing Portal: Stripe Dashboard → Settings → Billing → Customer portal (configure features); app opens sessions via POST /api/stripe/customer-portal
#
# Price ids for /pricing + checkout allow-list (optional; restrict Checkout to these Dashboard prices):
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
#
# Optional demo pricing for /taxnexus + POST /api/create-checkout (planId pro_123 / contains "pro"|"basic"|"team"):
# LEMON_VARIANT_PRO=123456
#
# Lemon Squeezy (optional; when any var is set, all six are required — see src/lib/server/env.ts)
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# LEMON_SQUEEZY_ENVIRONMENT=sandbox
# LEMON_SQUEEZY_CHECKOUT_SUCCESS_URL=https://localhost:5173/account
# LEMON_SQUEEZY_CHECKOUT_CANCEL_URL=https://localhost:5173/pricing
# Webhook URL: https://<your-host>/api/lemonsqueezy/webhook
# Variant ids for /pricing + POST /api/lemonsqueezy/checkout (numeric):
# LEMON_VARIANT_BASIC=
# LEMON_VARIANT_PRO=
# LEMON_VARIANT_TEAM=
# Verify: npm run verify-lemon

# Prisma Database Connection (DB02-Prisma-Setup.md)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Port 3307 is the host port mapped to container's 3306
DATABASE_URL="mysql://mautic_db_user:superSecretUserPwd@localhost:3307/soloai_db"
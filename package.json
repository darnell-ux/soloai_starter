{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:emit": "tsc --project tsconfig.emit.json",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"pdf:submission": "node scripts/generate-submission-pdf.mjs",
		"pdf:submission-bundle": "node scripts/generate-submission-pdf.mjs --bundle",
		"validate-env": "tsx ./scripts/validate-env.ts",
		"verify-mautic": "tsx ./scripts/verify-mautic.ts",
		"verify-lemon": "tsx ./scripts/verify-lemon.ts",
		"check:secrets": "node scripts/check-secrets.mjs",
		"rotate-secret": "tsx ./scripts/rotate-secret.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.38.0",
		"@inngest/agent-kit": "^0.13.2",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-node": "^5.5.6",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@types/better-sqlite3": "^7.6.13",
		"@vitest/browser": "^3.2.4",
		"autoprefixer": "^10.5.0",
		"daisyui": "^5.5.19",
		"eslint": "^9.38.0",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"marked": "^18.0.3",
		"npm-check-updates": "^19.1.1",
		"playwright": "^1.56.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.14",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.1.10",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.109.1",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@fontsource/ibm-plex-serif": "^5.2.7",
		"@inlang/paraglide-js": "^2.4.0",
		"@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
		"@strapi/client": "^1.5.0",
		"better-auth": "^1.6.5",
		"better-sqlite3": "^12.9.0",
		"bottleneck": "^2.19.5",
		"dotenv": "^17.2.3",
		"klaro": "^0.7.21",
		"openai": "^6.5.0",
		"stripe": "^22.1.0"
	}
}

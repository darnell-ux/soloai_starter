{
	"kind": "collectionType",
	"collectionName": "faqs",
	"info": {
		"singularName": "faq",
		"pluralName": "faqs",
		"displayName": "FAQ",
		"description": "Frequently asked questions with categories, links, and helpfulness"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"question": {
			"type": "string",
			"required": true,
			"maxLength": 500
		},
		"answer": {
			"type": "richtext",
			"required": true
		},
		"category": {
			"type": "enumeration",
			"enum": ["general", "billing", "product", "account", "security"],
			"default": "general"
		},
		"sortOrder": {
			"type": "integer",
			"default": 0,
			"min": 0,
			"max": 999999
		},
		"relatedLinks": {
			"type": "component",
			"repeatable": true,
			"component": "shared.link"
		},
		"helpfulYes": {
			"type": "integer",
			"default": 0,
			"min": 0
		},
		"helpfulNo": {
			"type": "integer",
			"default": 0,
			"min": 0
		}
	}
}
